{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/connector-hub/connector-hub/schemas/plugin-manifest.schema.json",
  "title": "Connector Hub plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "plugin_id", "version", "capabilities", "required_secrets", "allowed_network_hosts", "supports_destructive_actions"],
  "properties": {
    "api_version": {"const": "connector-hub.plugin/v1"},
    "plugin_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 128},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$"}},
    "required_secrets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
    "allowed_network_hosts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))*$"}},
    "supports_destructive_actions": {"type": "boolean"}
  }
}
